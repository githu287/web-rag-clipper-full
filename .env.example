# =============================================================================
# web-rag-clipper-full 环境变量配置
# 复制为 .env 并填写实际值，禁止硬编码 API Key
# =============================================================================

# --- 应用 ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=change-me-to-a-secure-random-token

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_DATABASE=rag_clipper

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=page_chunks

# --- 阿里云百炼 OpenAI 兼容 API ---
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-v3
# 必须与 Milvus page_chunks Collection schema 的 embedding.dim 严格一致；
# 修改此值需要重建 Collection 并全量 re-ingest（Milvus FLOAT_VECTOR.dim 创建后不可变）。
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_LLM_MODEL=qwen-plus

# --- 文件上传 ---
# 原始文件本地存储根目录（相对项目根或绝对路径；LocalFileStorage 使用；默认 uploads）
UPLOAD_DIR=uploads

# --- Ingest / RAG 参数 ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=10  # 百炼 text-embedding-v3 单次请求最大行数硬限制为 10，请勿超过
# RAG_TOP_K 为未来预留配置（future config）：当前 RAG limit 由 API 参数决定（默认 5），
# candidate_limit 由服务端 max(limit, 10) 决定；调整业务默认值需修改 RagService，本字段当前不被读取。
RAG_TOP_K=5
MAX_PAGE_CONTENT_BYTES=2097152
INGEST_MAX_RETRIES=3
PROCESSING_TIMEOUT_SECONDS=600

# --- CORS（Chrome Extension origin，开发时可设为 *）---
CORS_ORIGINS=chrome-extension://*

# --- 用户 API Key 加密（Phase 3.4 认证体系）---
# AES-256-GCM 服务端主密钥：用于加密/解密用户阿里云百炼 API Key（users.api_key_ciphertext / nonce）。
# 值必须为「utf-8 编码后恰好 32 字节」的字符串（如 python -c "import secrets; print(secrets.token_hex(16))" 生成 32 个 hex 字符）。
# 必须由部署者自行生成并妥善保存，不得提交 Git；请勿将下方占位符当作真实值使用。
APP_MASTER_KEY=<32-byte base64 secret>
