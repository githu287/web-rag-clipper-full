# =============================================================================
# web-rag-clipper-full 环境变量配置
# 复制为 .env 并填写实际值，禁止硬编码 API Key
# =============================================================================

# --- 数据库 (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
MYSQL_DATABASE=rag_clipper

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
INGEST_QUEUE_NAME=web-rag:ingest
INGEST_PAYLOAD_TTL_SECONDS=604800

# --- Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=page_chunks

# --- 阿里云百炼 OpenAI 兼容 API ---
# BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-v3
# 必须与 Milvus page_chunks Collection schema 的 embedding.dim 严格一致；
# 修改此值需要重建 Collection 并全量 re-ingest（Milvus FLOAT_VECTOR.dim 创建后不可变）。
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_LLM_MODEL=qwen-plus
# 百炼单次请求超时（秒）。不配置时 openai SDK 使用 600 秒默认值，
# 一次卡住的上游调用会长时间占住请求线程，因此后端显式传入这两个值。
BAILIAN_EMBEDDING_TIMEOUT_SECONDS=30
BAILIAN_LLM_TIMEOUT_SECONDS=60
# 百炼单次回答输出 token 上限。不限制时输出长度只由模型默认上限决定，
# 成本与延迟无上界；命中该上限时后端会记录「被截断」WARNING 日志。
BAILIAN_LLM_MAX_TOKENS=2048
# 百炼请求的 openai SDK 自动重试次数（对超时与连接错误生效，也是 429 限流的吸收次数）。
# 默认 2 与 SDK 自身默认值一致 → 不配置时行为完全不变。单请求最坏耗时约
# timeout × (max_retries + 1)：调大可容忍更久的抖动，调小（可为 0）更快失败但更容易被限流打穿。
BAILIAN_MAX_RETRIES=2

# --- 文件上传 ---
# 原始文件本地存储根目录（相对项目根或绝对路径；LocalFileStorage 使用；默认 uploads）
UPLOAD_DIR=uploads

# --- 可选云端视频总结（密钥通过扩展“视频”面板加密配置）---
VIDEO_MAX_UPLOAD_BYTES=104857600
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_SEGMENT_SECONDS=90
VIDEO_RETENTION_HOURS=24
VIDEO_RESULT_DAYS=7
VIDEO_FFMPEG=ffmpeg

# --- Ingest / RAG 参数 ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=10  # 百炼 text-embedding-v3 单次请求最大行数硬限制为 10，请勿超过
MAX_PAGE_CONTENT_BYTES=2097152
# 单个工作空间参与全库检索的 SUCCESS 文档数上限（按 document_id 倒序取最新 N 篇）。
# 检索时这些 id 会逐项拼进 Milvus 过滤表达式：没有上限则表达式长度、MySQL 取回行数
# 与日志规模都随文档数线性增长，表达式过长会被服务端直接拒绝（问答请求报错）。
# 超出上限的旧文档本次不参与检索，后端记录一条 WARNING 说明只检索了最新 N 篇。
# 同一值也是写入侧配额：当前空间文档数（含 PENDING / FAILED 等全部状态）达到上限时，
# 新的剪藏与上传直接被拒（HTTP 429，提示先删除部分文档）；同一 URL 重新剪藏不占新额度。
MAX_DOCUMENTS_PER_WORKSPACE=188
INGEST_MAX_RETRIES=3

# --- CORS（Chrome Extension origin，开发时可设为 *）---
CORS_ORIGINS=chrome-extension://*

# --- 用户 API Key 加密（Phase 3.4 认证体系）---
# AES-256-GCM 服务端主密钥：用于加密/解密 Workspace 的阿里云百炼 API Key。
# 值必须为「utf-8 编码后恰好 32 字节」的字符串（如 python -c "import secrets; print(secrets.token_hex(16))" 生成 32 个 ASCII 字符）。
# 必须由部署者自行生成并妥善保存，不得提交 Git。下方故意留空，运行前必须填入。
APP_MASTER_KEY=
