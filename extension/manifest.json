{
  "manifest_version": 3,
  "name": "Web RAG Clipper",
  "version": "0.18.0",
  "description": "剪藏网页与视频笔记到个人知识库，支持连接共享服务端及恢复工作区登录",
  "action": {
    "default_title": "Web RAG Clipper"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:18001/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
