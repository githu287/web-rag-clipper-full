{
  "manifest_version": 3,
  "name": "Web RAG Clipper",
  "version": "0.1.0",
  "description": "剪藏当前网页正文到 Web RAG Clipper 知识库（本地后端 http://localhost:8000）",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web RAG Clipper"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
