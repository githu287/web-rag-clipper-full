{
  "manifest_version": 3,
  "name": "Web RAG Clipper",
  "version": "0.16.1",
  "description": "剪藏当前网页正文到 Web RAG Clipper 知识库（本地后端 http://localhost:18001）",
  "action": {
    "default_title": "Web RAG Clipper"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:18001/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
